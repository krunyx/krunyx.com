\documentclass{hypertex}
\title{How an Epidemic Peaks: the SIR Model}
\author{krunyx · HyperTeX examples}
\date{November 2026}
\keywords{epidemiology, SIR model, basic reproduction number, herd immunity}
\abstract{The SIR model splits a population into the susceptible, the infected and the recovered. From three short equations it predicts whether an outbreak grows, how high it peaks and how many people it reaches in the end. Move the slider for the basic reproduction number $R_0$ to redraw the curves. A \href{briefing.md}{one-page briefing} turns the results into policy language.}
\newcommand{\dd}{\mathrm{d}}
\newcommand{\dv}[2]{\frac{\dd #1}{\dd #2}}
\newcommand{\Rz}{R_0}
\parameter{\R}{1.1}{6}{2.5}[step=0.1]

\begin{document}
\maketitle

\section{The model}\label{sec:model}
Measure each group as a fraction of the population, so that $S + I + R = 1$. Infected people meet susceptible
ones at a rate $\beta$ and recover at a rate $\gamma$ \cite{km1927}:
\begin{align}
  \dv{S}{t} &= -\beta S I, \label{eq:S} \\
  \dv{I}{t} &= \beta S I - \gamma I, \label{eq:I} \\
  \dv{R}{t} &= \gamma I. \label{eq:R}
\end{align}
The single number that matters is the \emph{basic reproduction number}
\begin{equation}\label{eq:R0}
  \Rz = \frac{\beta}{\gamma},
\end{equation}
the number of people one infected person infects in a fully susceptible population.
The slider sets it to $\Rz = \showparam{\R}$.

\begin{theorem}[Threshold]\label{thm:threshold}
An outbreak that starts with almost everyone susceptible grows if and only if $\Rz > 1$.
\end{theorem}

\begin{proof}[collapsed]
Equation~\eqref{eq:I} reads $\dv{I}{t} = \gamma I\,(\Rz S - 1)$. At the start $S \approx 1$, so $I$ grows exactly when $\Rz > 1$.
\end{proof}

\section{The epidemic curve}\label{sec:curve}
The equations have no closed-form solution in time, so figure~\ref{fig:data} plots a numerical solution for
$\Rz = 2.5$ and $\gamma = 0.1$ per day (the data are in \href{data/sir.csv}{data/sir.csv}).
Figure~\ref{fig:family} compares three values of $\Rz$: a larger $\Rz$ peaks sooner and higher.

